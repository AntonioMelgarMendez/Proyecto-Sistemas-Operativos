u001b[0m  \u001b[0m\r\n\r\u001b[2K\u001b[0m  \u001b[90m\u2502\u001b[0m  \u001b[1;36m\u25cf\u001b[0m \u001b[1;36mEn ejecucion\u001b[0m                                \u001b[90m\u2502\u001b[0m     \u001b[90m\u2502\u001b[0m  \u001b[1;35m\u25cf\u001b[0m \u001b[1;35mEn ejecucion\u001b[0m                                \u001b[90m\u2502\u001b[0m  \u001b[0m\r\n\r\u001b[2K\u001b[0m  \u001b[90m\u2502\u001b[0m  \u001b[1;37m1 de 12\u001b[0m \u001b[90mproducidos\u001b[0m                            \u001b[90m\u2502\u001b[0m     \u001b[90m\u2502\u001b[0m  \u001b[1;37m1 de 12\u001b[0m \u001b[90mconsumidos\u001b[0m                            \u001b[90m\u2502\u001b[0m  \u001b[0m\r\n\r\u001b[2K\u001b[0m  \u001b[90m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m     \u001b[90m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m  \u001b[0m\r\n\r\u001b[2K\u001b[0m                           \u001b[90mPRODUCTOR \u2500\u2500 insertar \u2192 \u001b[1;37mBUFFER\u001b[1;35m \u2500\u2500 extraer \u2192 CONSUMIDOR\u001b[0m                            \u001b[0m\r\n\r\u001b[2K\u001b[0m  \u001b[1;37mBUFFER\u001b[0m                                                                                              \u001b[1;33m0 / 5\u001b[0m  \u001b[0m\r\n\r\u001b[2K\u001b[0m                                                                                                             \u001b[0m\r\n\r\u001b[2K\u001b[0m                       \u001b[1;35m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m  \u001b[90m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m  \u001b[90m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m  \u001b[90m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m  \u001b[90m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m                       \u001b[0m\r\n\r\u001b[2K\u001b[0m                       \u001b[1;35m\u2502\u001b[0m    \u001b[1;35m\u00b7\u001b[0m    \u001b[1;35m\u2502\u001b[0m  \u001b[90m\u2502\u001b[0m    \u001b[90m\u00b7\u001b[0m    \u001b[90m\u2502\u001b[0m  \u001b[90m\u2502\u001b[0m    \u001b[90m\u00b7\u001b[0m    \u001b[90m\u2502\u001b[0m  \u001b[90m\u2502\u001b[0m    \u001b[90m\u00b7\u001b[0m    \u001b[90m\u2502\u001b[0m  \u001b[90m\u2502\u001b[0m    \u001b[90m\u00b7\u001b[0m    \u001b[90m\u2502\u001b[0m                       \u001b[0m\r\n"]
[3.168818, "o", "\r\u001b[2K\u001b[0m                       \u001b[1;35m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m  \u001b[90m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m  \u001b[90m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m  \u001b[90m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m  \u001b[90m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m                       \u001b[0m\r\n\r\u001b[2K\u001b[0m                                                  \u001b[90mEn curso\u001b[0m                                                   \u001b[0m\r\n\r\u001b[2K\u001b[0m                                    \u001b[90mUltimo evento: consumidor retiro 001\u001b[0m                                     \u001b[0m\r\n\r\u001b[2K\u001b[0m                        \u001b[90mEvidencia:\u001b[0m  \u001b[1;32m\u2713\u001b[0m \u001b[1;32mEspero\u001b[0m    \u001b[1;32m\u2713\u001b[0m \u001b[1;32mRecibio senal\u001b[0m     \u001b[1;32m\u2713\u001b[0m \u001b[1;32mContinuo\u001b[0m                               \u001b[0m\r\n\r\u001b[2K\u001b[0m                                                                                                             \u001b[0m\r\n\r\u001b[2K\u001b[0m                                                                                                             \u001b[0m\r\n\r\u001b[2K\u001b[0m                                                                                                             \u001b[0m\r\n\r\u001b[2K\u001b[0m                                                                                                             \u001b[0m\r\n\r\u001b[2K\u001b[0m                                                                                                             \u001b[0m\r\n\r\u001b[2K\u001b[0m                                                                                                             \u001b