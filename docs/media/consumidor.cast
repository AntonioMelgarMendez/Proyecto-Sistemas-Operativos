[4.266514, "o", "\u001b[H\r\u001b[2K\u001b[0m                                                                                                             \u001b[0m\r\n\r\u001b[2K\u001b[0m  \u001b[1;37mMONITOR\u001b[0m                                                                \u001b[90m02 / CONSUMIDOR   Ritmo: 250 ms\u001b[0m     \u001b[0m\r\n\r\u001b[2K\u001b[0m  \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m  \u001b[0m\r\n\r\u001b[2K\u001b[0m                                                                                                             \u001b[0m\r\n\r\u001b[2K\u001b[0m  \u001b[90m\u256d\u2500\u2500\u001b[1;36m PRODUCTOR \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m     \u001b[90m\u256d\u2500\u2500\u001b[1;35m CONSUMIDOR \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m  \u001b[0m\r\n"]
[4.269277, "o", "\r\u001b[2K\u001b[0m  \u001b[90m\u2502\u001b[0m                                                \u001b[90m\u2502\u001b[0m     \u001b[90m\u2502\u001b[0m                                                \u001b[90m\u2502\u001b[0m  \u001b[0m\r\n\r\u001b[2K\u001b[0m  \u001b[90m\u2502\u001b[0m  \u001b[1;36m\u25cf\u001b[0m \u001b[1;36mEn ejecucion\u001b[0m                                \u001b[90m\u2502\u001b[0m     \u001b[90m\u2502\u001b[0m  \u001b[1;35m\u25cf\u001b[0m \u001b[1;35mEn ejecucion\u001b[0m                                \u001b[90m\u2502\u001b[0m  \u001b[0m\r\n\r\u001b[2K\u001b[0m  \u001b[90m\u2502\u001b[0m  \u001b[1;37m5 de 12\u001b[0m \u001b[90mproducidos\u001b[0m                            \u001b[90m\u2502\u001b[0m     \u001b[90m\u2502\u001b[0m  \u001b[1;37m5 de 12\u001b[0m \u001b[90mconsumidos\u001b[0m                            \u001b[90m\u2502\u001b[0m  \u001b[0m\r\n\r\u001b[2K\u001b[0m  \u001b[90m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m     \u001b[90m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m  \u001b[0m\r\n\r\u001b[2K\u001b[0m                           \u001b[90mPRODUCTOR \u2500\u2500 insertar \u2192 \u001b[1;37mBUFFER\u001b[1;35m \u2500\u2500 extraer \u2192 CONSUMIDOR\u001b[0m                            \u001b[0m\r\n\r\u001b[2K\u001b[0m  \u001b[1;37mBUFFER\u001b[0m                                                                                              \u001b[1;33m0 / 5\u001b[0m  \u001b[0m\r\n\r\u001b[2K\u001