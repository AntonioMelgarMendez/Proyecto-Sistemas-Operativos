[8.255673, "o", "\r\u001b[2K\u001b[0m    \u001b[1;36m[1] Productor bloqueado\u001b[0m                                                                                  \u001b[0m\r\n\r\u001b[2K\u001b[0m        \u001b[90mLlenar el buffer y esperar espacio.\u001b[0m                                                                  \u001b[0m\r\n\r\u001b[2K\u001b[0m                                                                                                             \u001b[0m\r\n\r\u001b[2K\u001b[0m    \u001b[1;35m[2] Consumidor bloqueado\u001b[0m                                                                                 \u001b[0m\r\n\r\u001b[2K\u001b[0m        \u001b[90mEsperar datos con el buffer vacio.\u001b[0m                                                                   \u001b[0m\r\n\r\u001b[2K\u001b[0m                                                                                                             \u001b[0m\r\n\r\u001b[2K\u001b[0m    \u001b[1;37m[3] Flujo continuo\u001b[0m                                                                                       \u001b[0m\r\n\r\u001b[2K\u001b[0m        \u001b[90mAmbos hilos trabajan desde el inicio.\u001b[0m                                                                \u001b[0m\r\n\r\u001b[2K\u001b[0m                                                                                                             \u001b[0m\r\n\r\u001b[2K\u001b[0m  \u001b[90mCapacidad 5 | Meta 12 | Se reinician buffer y contadores.\u001b[0m                                                  \u001b[0m\r\n\r\u001b[2K\u001b[0m                                                                                                             \u001b[0m\r\n\r\u001b[2K\u001b[0m  \u001b[90mCaso finalizado. Puedes repetirlo o elegir otro.\u001b[0m                                                           \u001b[0m\r\n\r\u001b[2K\u001b[0m                                                                                                     