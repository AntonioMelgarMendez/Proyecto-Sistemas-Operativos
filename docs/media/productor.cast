\u001b[0m  \u001b[0m\r\n\r\u001b[2K\u001b[0m  \u001b[90m\u2502\u001b[0m  \u001b[1;32m\u25cf\u001b[0m \u001b[1;32mTerminado\u001b[0m                                   \u001b[90m\u2502\u001b[0m     \u001b[90m\u2502\u001b[0m  \u001b[1;35m\u25cf\u001b[0m \u001b[1;35mEn ejecucion\u001b[0m                                \u001b[90m\u2502\u001b[0m  \u001b[0m\r\n\r\u001b[2K\u001b[0m  \u001b[90m\u2502\u001b[0m  \u001b[1;37m12 de 12\u001b[0m \u001b[90mproducidos\u001b[0m                           \u001b[90m\u2502\u001b[0m     \u001b[90m\u2502\u001b[0m  \u001b[1;37m9 de 12\u001b[0m \u001b[90mconsumidos\u001b[0m                            \u001b[90m\u2502\u001b[0m  \u001b[0m\r\n\r\u001b[2K\u001b[0m  \u001b[90m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m     \u001b[90m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m  \u001b[0m\r\n\r\u001b[2K\u001b[0m                           \u001b[90mPRODUCTOR \u2500\u2500 insertar \u2192 \u001b[1;37mBUFFER\u001b[1;35m \u2500\u2500 extraer \u2192 CONSUMIDOR\u001b[0m                            \u001b[0m\r\n\r\u001b[2K\u001b[0m  \u001b[1;37mBUFFER\u001b[0m      \u001b[90mProximo en salir: 010\u001b[0m                                                                   \u001b[90m3 / 5\u001b[0m  \u001b[0m\r\n\r\u001b[2K\u001b[0m                                                                                                             \u001b[0m\r\n\r\u001b[2K\u001b[0m                       \u001b[1;37m\u256d\u2500\u2500\u2500\u2500\u2