[2.104232, "o", "\u001b[H\r\u001b[2K\u001b[0m                                                                                                             \u001b[0m\r\n\r\u001b[2K\u001b[0m  \u001b[1;37mMONITOR\u001b[0m                                                                \u001b[90m01 / PRODUCTOR   Ritmo: 250 ms\u001b[0m      \u001b[0m\r\n\r\u001b[2K\u001b[0m  \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m  \u001b[0m\r\n\r\u001b[2K\u001b[0m                                                                                                             \u001b[0m\r\n\r\u001b[2K\u001b[0m  \u001b[90m\u256d\u2500\u2500\u001b[1;36m PRODUCTOR \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m     \u001b[90m\u256d\u2500\u2500\u001b[1;35m CONSUMIDOR \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m  \u001b[0m\r\n\r\u001b[2K\u001b[0m  \u001b[90m\u2502\u001b[0m                                                \u001b[90m\u2502\u001b[0m     \u001b[90m\u2502\u001b[0m                                                \u001b[90m\u2502