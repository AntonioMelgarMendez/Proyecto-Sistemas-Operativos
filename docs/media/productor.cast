[1.194226, "o", "\r\u001b[2K\u001b[0m                                                                                                             \u001b[0m\r\n\r\u001b[2K\u001b[0m  \u001b[90m\u256d\u2500\u2500\u001b[1;36m PRODUCTOR \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m     \u001b[90m\u256d\u2500\u2500\u001b[1;35m CONSUMIDOR \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m  \u001b[0m\r\n\r\u001b[2K\u001b[0m  \u001b[90m\u2502\u001b[0m                                                \u001b[90m\u2502\u001b[0m     \u001b[90m\u2502\u001b[0m                                                \u001b[90m\u2502\u001b[0m  \u001b[0m\r\n\r\u001b[2K\u001b[0m  \u001b[90m\u2502\u001b[0m  \u001b[1;36m\u25cf\u001b[0m \u001b[1;36mEn ejecucion\u001b[0m                                \u001b[90m\u2502\u001b[0m     \u001b[90m\u2502\u001b[0m  \u001b[1;35m\u25cb\u001b[0m \u001b[1;35mPendiente de iniciar\u001b[0m                        \u001b[90m\u2502\u001b[0m  \u001b[0m\r\n\r\u001b[2K\u001b[0m  \u001b[90m\u2502\u001b[0m  \u001b[1;37m5 de 12\u001b[0m \u001b[90mproducidos\u001b[0m                            \u001b[90m\u2502\u001b[0m     \u001b[90m\u2502\u001b[0m  \u001b[1;37m0 de 12\u001b[0m \u001b[90mconsumidos\u001b[0m                            \u001b[90m\u2502\u001b[0m  \u001b[0m\r\n\r\u001b[2K\u001b[0m  \u001b[90m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m     \u001b[90m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m  \u001b[0m\r\n\r\u001b[2K\u001b[0m                           \u001b[1;36mPRODUCTOR \u2500\u2500 insertar \u2192 \u001b[1;37mBUFFER\u001b[90m \u2500\u2500 extraer \u2192 CONSUMIDOR\u001b[0m                            \u001b[0m\r\n\r\u001b[2K\u001b[0m  \u001b[1;37mBUFFER\u001b[0m      \u001b[90mProximo en salir: 001\u001b[0m                                                                   \u001b[1;33m5 / 5\u001b[0m  \u001b[0m\r\n\r\u001b[2K\u001b[0m                                                                                                             \u001b[0m\r\n\r\u001b[2K\u001b[0m                       \u001b[1;37m\u256d\u2500\u2500\u2500\u2500\u25bc\u2500\u2500\u2500\u2500\u256e\u001b[0m  \u001b[1;37m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m  \u001b[1;37m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m  \u001b[1;37m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m  \u001b[1;36m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m                       \u001b[0m\r\n\r\u001b[2K\u001b[0m                       \u001b[1;37m\u2502\u001b[0m   \u001b[1;37m001\u001b[0m   \u001b[1;37m\u2502\u001b[0m  \u001b[1;37m\u2502\u001b[0m   \u001b[1;37m002\u001b[0m   \u001b[1;37m\u2502\u001b[0m  \u001b[1;37m\u2502\u001b[0m   \u001b[1;37m003\u001b[0m   \u001b[1;37m\u2502\u001b[0m  \u001b[1;37m\u2502\u001b[0m   \u001b[1;37m004\u001b[0m   \u001b[1;37m\u2502\u001b[0m  \u001b[1;36m\u2502\u001b[0m   \u001b[1;36m005\u001b[0m   \u001b[1;36m\u2502\u001b[0m                       \u001b[0m\r\n\r\u001b[2K\u001b[0m                       \u001b[1;37m\u2570\u2500\u2500\u