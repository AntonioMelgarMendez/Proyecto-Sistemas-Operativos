[7.208827, "o", "\r\u001b[2K\u001b[0m                       \u001b[90m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m  \u001b[1;35m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m  \u001b[90m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m  \u001b[90m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m  \u001b[90m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m                       \u001b[0m\r\n\r\u001b[2K\u001b[0m                       \u001b[90m\u2502\u001b[0m    \u001b[90m\u00b7\u001b[0m    \u001b[90m\u2502\u001b[0m  \u001b[1;35m\u2502\u001b[0m    \u001b[1;35m\u00b7\u001b[0m    \u001b[1;35m\u2502\u001b[0m  \u001b[90m\u2502\u001b[0m    \u001b[90m\u00b7\u001b[0m    \u001b[90m\u2502\u001b[0m  \u001b[90m\u2502\u001b[0m    \u001b[90m\u00b7\u001b[0m    \u001b[90m\u2502\u001b[0m  \u001b[90m\u2502\u001b[0m    \u001b[90m\u00b7\u001b[0m    \u001b[90m\u2502\u001b[0m                       \u001b[0m\r\n\r\u001b[2K\u001b[0m                       \u001b[90m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m  \u001b[1;35m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m  \u001b[90m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m  \u001b[90m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m  \u001b[90m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m                       \u001b[0m\r\n\r\u001b[2K\u001b[0m                                                  \u001b[90mEn curso\u001b[0m                                                   \u001b[0m\r\n\r\u001b[2K\u001b[0m                                    \u001b[90mUltimo evento: consumidor retiro 012\u001b[0m                                     \u001b[0m\r\n\r\u001b[2K\u001b[0m                        \u001b[90mEvidencia:\u001b[0m  \u001b[1;32m\u2713\u001b[0m \u001b[1;32mEspero\u00