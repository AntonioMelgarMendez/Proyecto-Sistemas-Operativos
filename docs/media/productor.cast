[0.000554, "o", "\u001b[H\r\u001b[2K\u001b[1;36m  MONITORES / LABORATORIO DE SINCRONIZACION                         C17 + POSIX\u001b[0m\r\n\r\u001b[2K\u001b[90m  Un mutex | Dos condiciones | Sin semaforos | Snapshot consistente\u001b[0m\r\n\r\u001b[2K\u001b[90m------------------------------------------------------------------------------------------------------------\u001b[0m\r\n\r\u001b[2K\u001b[1;37m  Bloqueo del productor   |   Ritmo: 250 ms   |   Meta: 12 elementos\u001b[0m\r\n\r\u001b[2K\u001b[1;36m  [P] PRODUCTOR   NO INICIADO    insertados: 0        esperas: 0\u001b[0m\r\n\r\u001b[2K\u001b[1;35m  [C] CONSUMIDOR  NO INICIADO    extraidos:  0        esperas: 0\u001b[0m\r\n\r\u001b[2K\u001b[90m------------------------------------------------------------------------------------------------------------\u001b[0m\r\n\r\u001b[2K\u001b[90m  PRODUCTOR  ===== insertar =====>  BUFFER  ===== extraer =====>  CONSUMIDOR\u001b[0m\r\n\r\u001b[2K\u001b[1;32m  [   .   ] [   .   ] [   .   ] [   .   ] [   .   ] \u001b[0m\r\n\r\u001b[2K\u001b[90m    0:HT      1:--      2:--      3:--      4:--    \u001b[0m\r\n\r\u001b[2K\u001b[1;33m  [........................] 0/5 | H: sacar  T: insertar  { }: ultima transferencia\u001b[0m\r\n"]
[0.000582, "o", "\r\u001b[2K\u001b[90m  Esperando la primera transferencia real...\u001b[0m\r\n\r\u001b[2K\u001b[90m------------------------------------------------------------------------------------------------------------\u001b[0m\r\n\r\u001b[2K\u001b[1;37m  Preparando el bloqueo: el segundo hilo aun no existe.\u001b[0m\r\n\r\u001b[2K\u001b[1;33m  Evidencia: WAIT #0 > GET #0 > SIGNAL #0 > WAKE #0 > PUT #0\u001b[0m\r\n\r\u001b[2K\u001b[90m  signal no transfiere el mutex. #0 = evento aun no observado.\u001b[0m\r\n\r\u001b[2K\u001b[1;37m  CRONOLOGIA RECIENTE (historial acotado, no animacion simulada)\u001b[0m\r\n\r\u001b[2K\u001b[90m------------------------------------------------------------------------------------------------------------\u001b[0m\r\n\r\u001b[2K\u001b[1;37m  [Enter] Iniciar otro hilo cuando espere | [+/-] Rapido/lento | [Q] Salir\u001b[0m\r\n\r\u001b[2K\u001b[90m  Cian: productor | Magenta: consumidor | Amarillo: espera | Verde: resultado\u001b[0m\r\n\u001b[J"]
[0.030856, "o", "\u001b[H\r\u001b[2K\u001b[1;36m  MONITORES / LABORATORIO DE SINCRONIZACION                         C17 + POSIX\u001b[0m\r\n\r\u001b[2K\u001b[90m  Un mutex | Dos condiciones | Sin semaforos | Snapshot consistente\u001b[0m\r\n\r\u001b[2K\u001b[90m------------------------------------------------------------------------------------------------------------\u001b[0m\r\n\r\u001b[2K\u001b[1;37m  Bloqueo del productor   |   Ritmo: 250 ms   |   Meta: 12 elementos\u001b[0m\r\n\r\u001b[2K\u001b[1;36m  [P] PRODUCTOR   ACTIVO         insertados: 1        esperas: 0\u001b[0m\r\n\r\u001b[2K\u001b[1;35m  [C] CONSUMIDOR  NO INICIADO    extraidos:  0        esperas: 0\u001b[0m\r\n\r\u001b[2K\u001b[90m------------------------------------------------------------------------------------------------------------\u001b[0m\r\n\r\u001b[2K\u001b[1;36m  PRODUCTOR  ===== insertar =====>  BUFFER  ===== extraer =====>  CONSUMIDOR\u001b[0m\r\n\r\u001b[2K\u001b[1;32m  {      1} [   .   ] [   .   ] [   .   ] [   .   ] \u001b[0m\r\n\r\u001b[2K\u001b[90m    0:H-      1:-T      2:--      3:--      4:--    \u001b[0m\r\n\r\u001b[2K\u001b[1;32m  [####....................] 1/5 | H: sacar  T: insertar  { }: ultima transferencia\u001b[0m\r\n\r\u001b[2K\u001b[1;36m  Ultimo movimiento real: P ---> BUFFER elemento 1 (#2)\u001b[0m\r\n\r\u001b[2K\u001b[90m------------------------------------------------------------------------------------------------------------\u001b[0m\r\n\r\u001b[2K\u001b[1;37m  Preparando el bloqueo: el segundo hilo aun no existe.\u001b[0m\r\n\r\u001b[2K\u001b[1;33m  Evidencia: WAIT #0 > GET #0 > SIGNAL #0 > WAKE #0 > PUT #0\u001b[0m\r\n\r\u001b[2K\u001b[90m  signal no transfiere el mutex. #0 = evento aun no observado.\u001b[0m\r\n\r\u001b[2K\u001b[1;37m  CRONOLOGIA RECIENTE (historial acotado, no animacion simulada)\u001b[0m\r\n\r\u001b[2K\u001b[1;36m  #0001       0ms START  Productor inicia\u001b[0m\r\n\r\u001b[2K\u001b[1;36m  #0002       0ms PUT    Productor inserta element