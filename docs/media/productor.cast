u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m  \u001b[1;37m\u256d\u2500\u2500\u2500\u2500\u25bc\u2500\u2500\u2500\u2500\u256e\u001b[0m  \u001b[1;37m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m  \u001b[1;37m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m  \u001b[1;37m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m                       \u001b[0m\r\n\r\u001b[2K\u001b[0m                       \u001b[1;36m\u2502\u001b[0m   \u001b[1;36m011\u001b[0m   \u001b[1;36m\u2502\u001b[0m  \u001b[1;37m\u2502\u001b[0m   \u001b[1;37m007\u001b[0m   \u001b[1;37m\u2502\u001b[0m  \u001b[1;37m\u2502\u001b[0m   \u001b[1;37m008\u001b[0m   \u001b[1;37m\u2502\u001b[0m  \u001b[1;37m\u2502\u001b[0m   \u001b[1;37m009\u001b[0m   \u001b[1;37m\u2502\u001b[0m  \u001b[1;37m\u2502\u001b[0m   \u001b[1;37m010\u001b[0m   \u001b[1;37m\u2502\u001b[0m                       \u001b[0m\r\n\r\u001b[2K\u001b[0m                       \u001b[1;36m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m  \u001b[1;37m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m  \u001b[1;37m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m  \u001b[1;37m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m  \u001b[1;37m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m                       \u001b[0m\r\n\r\u001b[2K\u001b[0m                                                  \u001b[90mEn curso\u001b[0m                                                   \u001b[0m\r\n\r\u001b[2K\u001b[0m                                    \u001b[90mUltimo evento: productor inserto 011\u001b[0m                                     \u001b[0m\r\n"]
