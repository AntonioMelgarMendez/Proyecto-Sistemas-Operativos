[6.169454, "o", "\u001b[H\r\u001b[2K\u001b[0m                                                                                                             \u001b[0m\r\n\r\u001b[2K\u001b[0m  \u001b[1;37mMONITOR\u001b[0m                                                                \u001b[90m01 / PRODUCTOR   Ritmo: 250 ms\u001b[0m      \u001b[0m\r\n\r\u001b[2K\u001b[0m  \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m  \u001b[0m\r\n\r\u001b[2K\u001b[0m                                                                                                             \u001b[0m\r\n\r\u001b[2K\u001b[0m  \u001b[90m\u256d\u2500\u2500\u001b[1;36m PRODUCTOR \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m     \u001b[90m\u256d\u2500\u2500\u001b[1;35m CONSUMIDOR \u001b[90m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m  \u001b[0m\r\n\r\u001b[2K\u001b[0m  \u001b[90m\u2502\u001b[0m                                                \u001b[90m\u2502\u001b[0m     \u001b[90m\u2502\u001b[0m                                                \u001b[90m\u2502\u001b[0m  \u001b[0m\r\n\r\u001b[2K\u001b[0m  \u001b[90m\u2502\u001b[0m  \u001b[1;32m\u25cf\u001b[0m \u001b[1;32mTerminado\u001b[0m                                   \u001b[90m\u2502\u001b[0m     \u001b[90m\u2502\u001b[0m  \u001b[1;35m\u25cf\u001b[0m \u001b[1;35mEn ejecucion\u001b[0m                                \u001b[90m\u2502\u001b[0m  \u001b[0m\r\n\r\u001b[2K\u001b[0m  \u001b[90m\u2502\u001b[0m  \u001b[1;37m12 de 12\u001b[0m \u001b[90mproducidos\u001b[0m                           \u001b[90m\u2502\u001b[0m     \u001b[90m\u2502\u001b[0m  \u001b[1;37m8 de 12\u001b[0m \u001b[90mconsumidos\u001b[0m                            \u001b[90m\u2502\u001b[0m  \u001b[0m\r\n\r\u001b[2K\u001b[0m  \u001b[90m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m     \u001b[90m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m  \u001b[0m\r\n\r\u001b[2K\u001b[0m                           \u001b[90mPRODUCTOR \u2500\u2500 insertar \u2192 \u001b[1;37mBUFFER\u001b[1;35m \u2500\u2500 extraer \u2192 CONSUMIDOR\u001b[0m                            \u001b[0m\r\n\r\u001b[2K\u001b[0m  \u001b[1;37mBUFFER\u001b[0m      \u001b[90mProximo en salir: 009\u001b[0m                                                                   \u001b[90m4 / 5\u001b[0m  \u001b[0m\r\n\r\u001b[2K\u001b[0m                                                                                                             \u001b[0m\r\n\r\u001b[2K\u001b[0m                       \u001b[1;37m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m  \u001b[1;37m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m  \u001b[1;35m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m  \u001b[1;37m\u256d\u2500\u2500\u2500\u2500\u25bc\u2500\u2500\u2500\u2500\u256e\u001b[0m  \u001b[1;37m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m                       \u001b[0m\r\n\r\u001b[2K\u001b[0m                       \u001b[1;37m\u2502\u001b[0m   \u001b[1;37m011\u001b[0m   \u001b[1;37m\u2502\u001b[0m  \u001b[1;37m\u2502\u001b[0m   \u001b[1;37m012\u001b[0m   \u001b[1;37m\u2502\u001b[0m  \u001b[1;35m\u2502\u001b[0m    \u001b[1;35m\u00b7\u001b[0m    \u001b[1;35m\u2502\u001b[0m  \u001b[1;37m\u2502\u001b[0m   \u001b[1;37m009\u001b[0m   \u001b[1;37m\u2502\u001b[0m  \u001b[1;37m\u2502\u001b[0m   \u001b[1;37m010\u001b[0m   \u001b[1;37m\u2502\u001b[0m                       \u001b[0m\r\n\r\u001b[2K\u001b[0m                       \u001b[1;37m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m  \u001b[1;37m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m  \u001b[1;35m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m  \u001b[1;37m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m  \u001b[1;37m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m                       \u001b[0m\r\n"]
